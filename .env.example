# ============================================================
# KnucklesProducts — Environment Configuration
# ============================================================
# Copy this file to .env and update the values.
# For Docker: docker-compose automatically injects some values.
# For local development: update DB/Redis hosts to 127.0.0.1
# ============================================================

APP_NAME="KnucklesProducts"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# ── Logging ─────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database (MySQL — runs as separate container / AWS RDS) ─
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=knucklesproducts
DB_USERNAME=knuckles
DB_PASSWORD=

# ── Session (Redis — shared across app instances) ───────────
# Using Redis allows horizontal scaling: multiple app containers
# share the same session store, so users stay logged in
# regardless of which instance serves their request.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ── Queue (Redis — message broker between services) ─────────
# Jobs dispatched by the Laravel App are processed by the
# Queue Worker service (separate container). This enables
# asynchronous inter-service communication.
QUEUE_CONNECTION=redis

# ── Cache (Redis — shared across app instances) ─────────────
# Centralized cache ensures all app instances see the same
# cached data, preventing stale reads during horizontal scaling.
CACHE_STORE=redis

# ── Redis Connection ────────────────────────────────────────
# Redis serves triple duty: sessions, cache, and message broker.
# In production, use AWS ElastiCache or Azure Cache for Redis.
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Filesystem (S3 for production) ──────────────────────────
# Product images and static assets should be stored on S3
# (or compatible object storage) for durability and CDN support.
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=knucklesproducts-assets
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Mail ────────────────────────────────────────────────────
# For local dev: use log driver or Mailpit
# For production: use SES, Postmark, or SMTP
MAIL_MAILER=log
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@knucklesproducts.com"
MAIL_FROM_NAME="${APP_NAME}"

BROADCAST_CONNECTION=log

# ── OAuth (Google Login) ────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=${APP_URL}/auth/google/callback

# ── Frontend ────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
