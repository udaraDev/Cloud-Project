# ============================================================
# Docker Compose Environment
# ============================================================
# This file is used by docker-compose.yml
# Copy from .env.example and fill in the values
# ============================================================

APP_NAME="KnucklesProducts"
APP_ENV=local
APP_KEY=base64:OezltG7HjyYIgkgH3WuOWm/Dmwpvd3IPGMQ4iqW3XV8=
APP_DEBUG=true
APP_URL=http://localhost

# Database
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=knucklesproducts
DB_USERNAME=knuckles
DB_PASSWORD=secret

# Redis (cache + sessions + queue broker)
REDIS_HOST=redis
REDIS_PORT=6379

# Session & Cache via Redis
SESSION_DRIVER=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# Mail (log for now)
MAIL_MAILER=log
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@knucklesproducts.com"
MAIL_FROM_NAME="${APP_NAME}"

# Notification Service
NOTIFICATION_SERVICE_URL=http://notification-service:3001
